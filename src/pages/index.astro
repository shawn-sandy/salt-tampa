---
/**
 * Salt Tampa Outreach landing page.
 *
 * Built on `Base` rather than `Layout`: `Layout` wraps its default slot in
 * `<section><article>...</article><aside><Sidebar/></aside></section>`, and a
 * full-bleed landing page cannot live inside that article/sidebar grid.
 * `Base` supplies no `<main>` of its own, so this page provides one.
 *
 * Sections land here one at a time as they are rebuilt responsively. Hero and
 * services exist; mission, team, donate and testimonial follow.
 */
import Base from '#layouts/Base.astro'
import Hero from '#components/astro/salt/Hero.astro'
import Services from '#components/astro/salt/Services.astro'
import MissionBand from '#components/astro/salt/MissionBand.astro'
import MissionStatement from '#components/astro/salt/MissionStatement.astro'
import TeamSection from '#components/astro/salt/TeamSection.astro'
import ImageStrip from '#components/astro/salt/ImageStrip.astro'
import DonateBand from '#components/astro/salt/DonateBand.astro'
import Testimonial from '#components/astro/salt/Testimonial.astro'
import SaltFooter from '#components/astro/salt/Footer.astro'

import donateBg from '#assets/salt/images/donate-bg.png'
import volunteers from '#assets/salt/images/team-andrea.jpg'
import gymLineup from '#assets/salt/images/carousel-1.jpg'
import trailerBriefing from '#assets/salt/images/carousel-2.jpg'

/*
 * Two photographs, not the kit's four.
 *
 * `carousel-3.jpg` is a stock still-life of a leaf on a white studio
 * background -- nothing to do with Tampa or outreach -- so it is left out
 * rather than passed off as a photograph of this work. The kit's own demo
 * captions it "Guests sharing a meal at Trinity Cafe", which it plainly is not.
 *
 * The remaining candidates are already on this page: `outreach-tent.jpg` is the
 * barber service card and `team-andrea.jpg` is the quote band. Repeating either
 * a few hundred pixels further down reads as a thin photo library, so the strip
 * runs at two until more real photographs exist. Add them to this array.
 */
const STRIP = [
  {
    src: gymLineup,
    alt: 'Volunteers in red-striped serving aprons lined up across a school gym, bagged donations stacked along the wall behind them',
  },
  {
    src: trailerBriefing,
    alt: 'A volunteer with a microphone briefing the team in front of the Salt Tampa trailer, its chalkboard inviting people to step inside',
  },
]

/*
 * Only routes that exist. The source comp shipped `#mission` and `#volunteer`
 * anchors that were never on the page, and a `Donate` chip wired to a toast --
 * links are added here as their targets land, not before.
 */
const NAV_LINKS = [
  { label: 'Services', href: '#services' },
  { label: 'Mission', href: '#mission' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact-us' },
]

/*
 * Both routes render a page titled "Contact Us", so there is only one real
 * destination behind two labels. Volunteer enquiries go to `/message-us` and
 * general enquiries to `/contact-us` to keep the two buttons distinguishable,
 * but this wants a decision from the requester.
 */
const VOLUNTEER_HREF = '/message-us'
const CONTACT_HREF = '/contact-us'

/*
 * INTERIM. There is no giving URL anywhere in the repo and no donate route, so
 * the appeal points at the contact page: someone who wants to give can still
 * reach a human. It is the wrong destination for a button labelled "Donate"
 * and needs replacing with the real giving link before launch -- one line.
 *
 * The navbar chip is a different case: it scrolls to the appeal itself, which
 * is what the source did and is a real destination either way.
 */
const DONATE_HREF = '/contact-us'

/*
 * Verbatim from the source. The design system's readme is explicit that this
 * copy is a different register from the rest of the site and must not be
 * paraphrased, shortened or "tightened", so it is transcribed exactly -- minus
 * one zero-width space (U+200B) the Figma export left after "Immediate Needs",
 * which is invisible in the file and would give the browser a stray break
 * opportunity in the middle of the clause.
 */
const MISSION =
  "To Share Christ's Love by Serving the Unsheltered Through Comprehensive Mobile Outreach Centers that Serve Immediate Needs, Catalyze Permanent Housing Solutions, and Empower Self-Sufficiency"

const VISION =
  'That Every Metropolitan Area in the US has a Comprehensive Outreach Center for People Experiencing Homelessness'

/*
 * The same destinations as the navbar, plus the donate appeal. The source
 * footer carries a "Privacy Policy" link and a newsletter form; neither is
 * reproduced, because neither has anywhere to go:
 *
 * - there is no privacy policy page in this repo, and a legal link that 404s
 *   is worse than an absent one;
 * - there is no subscribe endpoint. `NewsletterForm` requires an `action` for
 *   exactly this reason -- the source's form called `preventDefault()` and
 *   fired a toast, so it looked like it worked and collected nothing. Omitting
 *   `newsletterAction` renders the footer without it.
 *
 * Both come back the moment a route exists: add `legal` and `newsletterAction`.
 */
const FOOTER_LINKS = [
  { label: 'Services', href: '#services' },
  { label: 'Mission', href: '#mission' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: CONTACT_HREF },
  { label: 'Donate', href: '#donate' },
]

/*
 * Resolved per request rather than hardcoded, so the year cannot go stale.
 * The source ships "2023 Ddsgnr. All right reserved." -- the design template
 * author's name, a dead year and a typo ("right" for "rights").
 */
const COPYRIGHT = `${new Date().getFullYear()} Salt Tampa Outreach. All rights reserved.`
---

<Base
  pageTitle="Salt Tampa Outreach"
  pageDescription="Sharing Christ's love by serving the unsheltered through mobile outreach centers in Tampa."
  hideHeader
  hideFooter
>
  <main id="main" tabindex="-1" class="st">
    <Hero links={NAV_LINKS} volunteerHref={VOLUNTEER_HREF} donateHref="#donate" />
    <Services volunteerHref={VOLUNTEER_HREF} contactHref={CONTACT_HREF} />
    {
      /*
       * Mission here, Vision in the quote band below. The source puts both on
       * this band AND cycles both through the quote band, so a faithful port
       * would print the same two statements twice within three sections. One
       * each keeps every word of the source copy on the page and says nothing
       * twice.
       */
    }
    <MissionBand id="mission">
      <MissionStatement label="Mission" statement={MISSION} />
    </MissionBand>
    {/* The source places the photo strip directly after the mission band. */}
    <ImageStrip images={STRIP} label="Photographs from Salt Tampa outreach days" />
    <TeamSection volunteerHref={VOLUNTEER_HREF} contactHref={CONTACT_HREF} />
    <DonateBand id="donate" image={donateBg} href={DONATE_HREF} />
    {
      /*
       * Labelled "Our Vision", not "Testimonials". The design calls this the
       * testimonial block, but no testimonial exists anywhere in the source --
       * no quotation, no speaker, no attribution; the kit only ever
       * demonstrates it with the mission statement. Calling a vision statement
       * a testimonial would assert that somebody said it.
       *
       * When a real quote and speaker arrive, pass `statement` and
       * `attribution` and set the label back -- the component renders a
       * `<figcaption>` for exactly that.
       */
    }
    <Testimonial
      label="Our Vision"
      statement={VISION}
      image={volunteers}
      imageAlt="Salt Tampa volunteers gathered on the street before a Saturday outreach"
    />
  </main>
  <SaltFooter links={FOOTER_LINKS} copyright={COPYRIGHT} />
</Base>
