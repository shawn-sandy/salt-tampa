---
/**
 * Salt Tampa Outreach landing page.
 *
 * Built on `Base` rather than `Layout`: `Layout` wraps its default slot in
 * `<section><article>...</article><aside><Sidebar/></aside></section>`, and a
 * full-bleed landing page cannot live inside that article/sidebar grid.
 * `Base` supplies no `<main>` of its own, so this page provides one.
 *
 * Sections land here one at a time as they are rebuilt responsively. Hero and
 * services exist; mission, team, donate and testimonial follow.
 */
import Base from '#layouts/Base.astro'
import Hero from '#components/astro/salt/Hero.astro'
import Services from '#components/astro/salt/Services.astro'
import MissionBand from '#components/astro/salt/MissionBand.astro'
import MissionStatement from '#components/astro/salt/MissionStatement.astro'
import TeamSection from '#components/astro/salt/TeamSection.astro'

/*
 * Only routes that exist. The source comp shipped `#mission` and `#volunteer`
 * anchors that were never on the page, and a `Donate` chip wired to a toast --
 * links are added here as their targets land, not before.
 */
const NAV_LINKS = [
  { label: 'Services', href: '#services' },
  { label: 'Mission', href: '#mission' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact-us' },
]

/*
 * Both routes render a page titled "Contact Us", so there is only one real
 * destination behind two labels. Volunteer enquiries go to `/message-us` and
 * general enquiries to `/contact-us` to keep the two buttons distinguishable,
 * but this wants a decision from the requester -- and a real donate URL, which
 * is why no donate control is rendered yet.
 */
const VOLUNTEER_HREF = '/message-us'
const CONTACT_HREF = '/contact-us'

/*
 * Verbatim from the source. The design system's readme is explicit that this
 * copy is a different register from the rest of the site and must not be
 * paraphrased, shortened or "tightened", so it is transcribed exactly -- minus
 * one zero-width space (U+200B) the Figma export left after "Immediate Needs",
 * which is invisible in the file and would give the browser a stray break
 * opportunity in the middle of the clause.
 */
const MISSION =
  "To Share Christ's Love by Serving the Unsheltered Through Comprehensive Mobile Outreach Centers that Serve Immediate Needs, Catalyze Permanent Housing Solutions, and Empower Self-Sufficiency"

const VISION =
  'That Every Metropolitan Area in the US has a Comprehensive Outreach Center for People Experiencing Homelessness'
---

<Base
  pageTitle="Salt Tampa Outreach"
  pageDescription="Sharing Christ's love by serving the unsheltered through mobile outreach centers in Tampa."
  hideHeader
>
  <main id="main" tabindex="-1" class="st">
    <Hero links={NAV_LINKS} volunteerHref={VOLUNTEER_HREF} />
    <Services volunteerHref={VOLUNTEER_HREF} contactHref={CONTACT_HREF} />
    <MissionBand id="mission">
      <MissionStatement label="Mission" statement={MISSION} />
      <MissionStatement label="Vision" statement={VISION} />
    </MissionBand>
    <TeamSection volunteerHref={VOLUNTEER_HREF} contactHref={CONTACT_HREF} />
  </main>
</Base>
