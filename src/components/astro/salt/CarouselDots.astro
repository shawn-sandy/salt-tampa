---
/**
 * The sage discs under the image carousel.
 *
 * `count` is the number of slides. The source's caller passed
 * `Math.max(images.length - 1, 1)`, which rendered four dots for a five-slide
 * carousel; the arithmetic is not reproduced here, and callers pass the real
 * slide count.
 *
 * These are position indicators, not controls: nothing here selects a slide,
 * so nothing here is focusable. The dots are decorative and the position is
 * carried by a visually hidden sentence, which is what a screen reader
 * actually needs. An earlier version rendered `role="tab"` buttons that did
 * nothing when activated -- a focus stop that leads nowhere.
 *
 * @component CarouselDots
 * @example
 * ```astro
 * <CarouselDots count={5} active={0} label="Outreach photographs" />
 * ```
 */
export type Props = {
  /** Number of slides. One dot each. */
  count: number
  /** Zero-based index of the current slide. */
  active?: number
  /** Diameter in px. */
  size?: number
  /** Names what is being paged through, used in the hidden position sentence. */
  label?: string
  class?: string
}

const { count, active = 0, size = 16, label = 'Slides', class: className } = Astro.props as Props
---

<div class:list={['st-dots', className]} style={`--st-dot-size:${size}px`}>
  <p class="st-dots__position">{`${label}: showing ${active + 1} of ${count}`}</p>
  {
    Array.from({ length: count }).map((_, i) => (
      <span aria-hidden="true" class:list={['st-dots__dot', i === active && 'is-active']} />
    ))
  }
</div>

<style>
  .st-dots {
    align-items: center;
    display: flex;
    flex-direction: row;
    gap: 15px;
  }

  /* Read by assistive technology, never painted. */
  .st-dots__position {
    clip-path: inset(50%);
    height: 1px;
    margin: 0;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .st-dots__dot {
    background: var(--st-sage);
    border-radius: 50%;
    display: block;
    flex: none;
    height: var(--st-dot-size);
    opacity: 0.45;
    width: var(--st-dot-size);
  }

  .st-dots__dot.is-active {
    opacity: 1;
  }
</style>
