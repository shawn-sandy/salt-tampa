---
/**
 * The complete Salt Tampa glyph vocabulary -- five paths, and no more.
 *
 * Path data is lifted verbatim from the source Figma file. The design system's
 * readme is explicit that this is the entire icon set and that Lucide,
 * Heroicons, Material, emoji and Unicode characters are never substituted; if a
 * brief needs a glyph that is not here, ask for it rather than importing one.
 *
 * `arrow-left` is `arrow-right` mirrored, which is why it has no path of its
 * own and is handled by the `flip` branch below.
 *
 * @component Icon
 * @example
 * ```astro
 * <Icon name="arrow-right" size={16} />
 * <Icon name="facebook" size={16} color="var(--st-white)" />
 * ```
 */
export type IconName = 'arrow-right' | 'arrow-left' | 'arrow-forward' | 'facebook' | 'linkedin'

export type Props = {
  /** Which glyph to draw. */
  name?: IconName
  /** Rendered width and height in px. The viewBox scales to fit. */
  size?: number
  /** Any CSS colour. Defaults to inheriting the parent's text colour. */
  color?: string
  /** Extra classes on the `<svg>`. */
  class?: string
}

const GLYPHS: Record<string, { viewBox: string; d: string }> = {
  'arrow-right': {
    viewBox: '-0.9 -0.9 5.85 9.9',
    d: 'M 0.53 -0.53 C 0.237 -0.823 -0.237 -0.823 -0.53 -0.53 C -0.823 -0.237 -0.823 0.237 -0.53 0.53 L 0 0 L 0.53 -0.53 Z M 4.047 4.047 L 4.577 4.577 C 4.718 4.436 4.797 4.246 4.797 4.047 C 4.797 3.848 4.718 3.657 4.577 3.516 L 4.047 4.047 Z M -0.53 7.563 C -0.823 7.856 -0.823 8.331 -0.53 8.624 C -0.237 8.917 0.237 8.917 0.53 8.624 L 0 8.093 L -0.53 7.563 Z M 0 0 L -0.53 0.53 L 3.516 4.577 L 4.047 4.047 L 4.577 3.516 L 0.53 -0.53 L 0 0 Z M 4.047 4.047 L 3.516 3.516 L -0.53 7.563 L 0 8.093 L 0.53 8.624 L 4.577 4.577 L 4.047 4.047 Z',
  },
  'arrow-forward': {
    viewBox: '0 -8 19 16',
    d: 'M 18.209 0.707 C 18.599 0.317 18.599 -0.317 18.209 -0.707 L 11.845 -7.071 C 11.454 -7.462 10.821 -7.462 10.431 -7.071 C 10.04 -6.681 10.04 -6.047 10.431 -5.657 L 16.088 0 L 10.431 5.657 C 10.04 6.047 10.04 6.681 10.431 7.071 C 10.821 7.462 11.454 7.462 11.845 7.071 L 18.209 0.707 Z M 0 0 L 0 1 L 17.502 1 L 17.502 0 L 17.502 -1 L 0 -1 L 0 0 Z',
  },
  facebook: {
    viewBox: '0 0 16 16',
    d: 'M 16 8 C 16 3.582 12.418 0 8 0 C 3.582 0 0 3.582 0 8 C 0 11.993 2.925 15.303 6.75 15.903 L 6.75 10.313 L 4.719 10.313 L 4.719 8 L 6.75 8 L 6.75 6.238 C 6.75 4.233 7.944 3.125 9.772 3.125 C 10.647 3.125 11.563 3.281 11.563 3.281 L 11.563 5.25 L 10.554 5.25 C 9.56 5.25 9.25 5.867 9.25 6.5 L 9.25 8 L 11.469 8 L 11.114 10.313 L 9.25 10.313 L 9.25 15.903 C 13.075 15.303 16 11.993 16 8 Z',
  },
  linkedin: {
    viewBox: '0 0 16 16',
    d: 'M 14.816 0 L 1.181 0 C 0.528 0 0 0.516 0 1.153 L 0 14.844 C 0 15.481 0.528 16 1.181 16 L 14.816 16 C 15.469 16 16 15.481 16 14.847 L 16 1.153 C 16 0.516 15.469 0 14.816 0 Z M 4.747 13.634 L 2.372 13.634 L 2.372 5.997 L 4.747 5.997 L 4.747 13.634 Z M 3.559 4.956 C 2.797 4.956 2.181 4.341 2.181 3.581 C 2.181 2.822 2.797 2.206 3.559 2.206 C 4.319 2.206 4.934 2.822 4.934 3.581 C 4.934 4.338 4.319 4.956 3.559 4.956 Z M 13.634 13.634 L 11.262 13.634 L 11.262 9.922 C 11.262 9.038 11.247 7.897 10.028 7.897 C 8.794 7.897 8.606 8.863 8.606 9.859 L 8.606 13.634 L 6.238 13.634 L 6.238 5.997 L 8.512 5.997 L 8.512 7.041 L 8.544 7.041 C 8.859 6.441 9.634 5.806 10.788 5.806 C 13.191 5.806 13.634 7.388 13.634 9.444 L 13.634 13.634 L 13.634 13.634 Z',
  },
}

const { name = 'arrow-right', size = 16, color = 'currentColor', class: className } = Astro.props as Props

const flip = name === 'arrow-left'
const glyph = GLYPHS[flip ? 'arrow-right' : name]
---

{
  glyph && (
    <svg
      width={size}
      height={size}
      viewBox={glyph.viewBox}
      fill={color}
      aria-hidden="true"
      class:list={['st-icon', flip && 'st-icon--flip', className]}
    >
      <path d={glyph.d} fill-rule="nonzero" />
    </svg>
  )
}

<style>
  .st-icon {
    display: block;
    flex-shrink: 0;
  }

  .st-icon--flip {
    transform: scaleX(-1);
  }
</style>
