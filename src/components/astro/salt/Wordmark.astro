---
/**
 * The Salt Tampa lockup, drawn from `public/images/salt-logo.svg`.
 *
 * The artwork is white on transparent and the footer sits on white, so it is
 * used as a CSS mask rather than an `<img>`: its alpha channel supplies the
 * shape and `currentcolor` supplies the ink. One asset covers both placements
 * -- white over the hero, sage in the footer -- with no second file and no
 * filter chain. The element carries `role="img"` and the brand name as its
 * accessible name, so a screen reader still announces "Salt Tampa".
 *
 * @component Wordmark
 * @example
 * ```astro
 * <Wordmark variant="nav" />
 * <Wordmark variant="footer" />
 * ```
 */
export type Props = {
  /** Which size to draw. */
  variant?: 'nav' | 'footer'
  /** Overrides the default colour (white for `nav`, sage for `footer`). */
  color?: string
  /** Extra classes on the root. */
  class?: string
}

const { variant = 'nav', color, class: className } = Astro.props as Props
---

<span
  class:list={['st-wordmark', `st-wordmark--${variant}`, className]}
  style={color ? `--st-wordmark-color:${color}` : undefined}
  role="img"
  aria-label="Salt Tampa"></span>

<style>
  .st-wordmark {
    /* The footer stacks its brand column with the default `stretch`, which
       would blow the box out to the column's full width and strand the mark in
       the middle of it. `start` holds the derived width. */
    align-self: start;

    /* The source viewBox is 1091x241; the ratio derives the width from the
       height below, so neither size restates the artwork's proportions. */
    aspect-ratio: 1091 / 241;
    background-color: var(--st-wordmark-color, currentcolor);
    display: inline-block;
    mask-image: url('/images/salt-logo.svg');
    mask-position: left center;
    mask-repeat: no-repeat;
    mask-size: contain;
  }

  .st-wordmark--nav {
    color: var(--st-white);
    height: 33px;
  }

  .st-wordmark--footer {
    color: var(--st-text-footer);
    height: 30px;
  }
</style>
